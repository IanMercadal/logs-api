    {
      "name": "3. Consulta - GET /logs",
      "item": [
        {
          "name": "3.1 Listar todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('estructura de paginacion', () => { pm.expect(j.items).to.be.an('array'); pm.expect(j.page).to.eql(1); pm.expect(j.limit).to.eql(20); });",
                  "pm.test('al menos los 4 logs creados', () => pm.expect(j.total).to.be.at.least(4));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ]
            }
          }
        },
        {
          "name": "3.2 Filtrar app=tienda",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('hay resultados', () => pm.expect(j.items.length).to.be.above(0));",
                  "pm.test('todos cumplen app = tienda', () => j.items.forEach(l => pm.expect(l.app).to.eql('tienda')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],

    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "keyTienda",
      "value": "abc123"
    },
    {
      "key": "keyReservas",
      "value": "def456"
    },
    {
      "key": "logId",
      "value": ""
    },
    {
      "key": "isoId",
      "value": ""
    },
    {
      "key": "longUser",
      "value": ""
    },
    {
      "key": "dFrom",
      "value": ""
    },
    {
      "key": "dTo",
      "value": ""
    }

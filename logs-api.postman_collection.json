  "item": [
    {
      "name": "1. Ingesta - casos correctos",
      "item": [
        {
          "name": "1.1 Crear log (tienda)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('app viene de la API key', () => pm.expect(j.app).to.eql('tienda'));",
                  "pm.test('devuelve id', () => pm.expect(j.id).to.not.be.undefined);",
                  "pm.test('action correcta', () => pm.expect(j.action).to.eql('product.update'));",
                  "pm.collectionVariables.set('logId', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{keyTienda}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest",
                "logs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"42\",\n  \"userLabel\": \"ana@tienda.com\",\n  \"action\": \"product.update\",\n  \"entity\": \"product\",\n  \"entityId\": \"1007\",\n  \"details\": {\n    \"price\": {\n      \"from\": 19.9,\n      \"to\": 24.9\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },

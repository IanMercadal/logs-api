        {
          "name": "3.7 Rango de fechas (ayer a manana)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = (off) => new Date(Date.now() + off * 86400000).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('dFrom', d(-1));",
                  "pm.collectionVariables.set('dTo', d(1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('hay resultados', () => pm.expect(pm.response.json().items.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logs?from={{dFrom}}&to={{dTo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{dFrom}}"
                },
                {
                  "key": "to",
                  "value": "{{dTo}}"
                }
              ]
            }
          }
        },
